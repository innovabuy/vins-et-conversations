# syntax=docker/dockerfile:1
# ---- Stage 1 : build ----
# Vite build en mode production → lit .env.production (VITE_API_URL=/api/v1, DEMO=false).
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build          # produit /app/dist

# ---- Stage 2 : serve ----
# nginx sert le build statique + fallback SPA + proxy /api,/uploads vers le service `api`.
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
